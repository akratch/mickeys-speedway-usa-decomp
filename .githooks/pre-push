#!/usr/bin/env bash
# Clean-room gate, push level.  The commit gate only ever sees the index of
# one commit; this one re-checks every commit actually leaving the machine, so
# a commit made before the hooks existed -- or made in another clone, or
# amended past the gate -- still cannot reach a remote.
#
# git calls this with the remote name in $1 and its URL in $2, and feeds one
# line per pushed ref on stdin:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# Active once `git config core.hooksPath .githooks` has been run; `gmake setup`
# does that.  See CLAUDE.md.  Do not pass --no-verify.

set -u

remote_name=${1-origin}

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "${local_sha:-}" ] || continue

	# Deleting a remote branch pushes no objects; there is nothing to scan.
	if [ "$local_sha" = "$ZERO" ]; then
		echo "pre-push: $remote_ref is being deleted, nothing to scan"
		continue
	fi

	have_remote=0
	if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		have_remote=1
	fi

	if [ "$have_remote" = 1 ]; then
		# Updating an existing remote branch: scan what is new.
		range="$remote_sha..$local_sha"
		label="$remote_ref ($range)"
	else
		# New branch, or a remote tip this clone has never seen: scan the whole
		# branch.
		#
		# An earlier version excluded everything reachable from the local
		# remote-tracking refs, reasoning that the remote already has those
		# commits.  That is only true while those refs are current, and the
		# operation that strands them -- a history rewrite -- is precisely the
		# operation this repository has already had to perform once.  A stale
		# refs/remotes entry would exclude commits the push does in fact
		# transmit, narrowing the scan at the moment it matters most.
		#
		# So: exclude nothing here.  A full-branch scan of this repository's
		# entire history costs under a second, which is not worth trading any
		# amount of correctness for.
		range="$local_sha"
		label="$remote_ref (new branch, full scan)"
	fi

	echo "pre-push: clean-room scan of $label"
	# shellcheck disable=SC2086
	if ! bash tools/cleanroom_check.sh --range "$range"; then
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	cat >&2 <<'EOF'

pre-push: BLOCKED by the clean-room gate.

At least one commit in this push carries ROM-derived content.  It is already
in history, so removing it means rewriting -- `git rebase -i` to drop or edit
the commit, or `git filter-repo --path <file> --invert-paths` -- not a follow-up
commit that deletes the file.  A deletion commit still ships the bytes.

Do not push with --no-verify.
EOF
	exit 1
fi
