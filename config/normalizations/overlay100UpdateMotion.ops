# Complete timestep-copy precolor: both values are identical and the later
# gravity (f14) and integration-scale (f0) consumers are already exact.
fields:0x54:sa=0x0@0xe
fields:0x6c:rd=0x0@0xe,sa=0xe@0x0

# Postfix countdown spelling emits a boolean in a2.  The shipped scheduler
# retains the full count in the otherwise-dead a2 home at both control sites;
# both branches consume a1 directly.
fields:0xc0:rs=zero@a1,rt=a1@zero,fn=43@37
fields:0xc8:rs=a2@a1
fields:0x110:rs=zero@a1,rt=a1@zero,fn=43@37
fields:0x164:rs=a2@a1

# Move the loop decrement from the pre-body schedule to the backedge delay.
# The branch stays pinned at +0x164; every intervening memory/FP effect keeps
# its original relative order.
reorder:0x120=0x124,0x124=0x128,0x128=0x12c,0x12c=0x130,0x130=0x134,0x134=0x138,0x138=0x13c,0x13c=0x140,0x140=0x144,0x144=0x148,0x148=0x14c,0x14c=0x150,0x150=0x154,0x154=0x158,0x158=0x15c,0x15c=0x160,0x160=0x168,0x168=0x120
