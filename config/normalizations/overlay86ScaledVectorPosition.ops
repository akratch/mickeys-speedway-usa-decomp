# IDO places the three address-taken floats at sp+0x24..0x2C while retail
# uses the equivalent contiguous local home sp+0x20..0x28. This is the
# complete producer/consumer ledger for that private local block.
fields:0x54:imm=0x24@0x20
fields:0x6c:imm=0x24@0x20
fields:0x78:imm=0x28@0x24
fields:0x88:imm=0x2c@0x28
fields:0x8c:imm=0x24@0x20
fields:0xa4:imm=0x28@0x24
fields:0xb8:imm=0x2c@0x28
