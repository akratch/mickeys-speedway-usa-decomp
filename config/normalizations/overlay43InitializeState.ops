# Complete private pre-call schedule web. candidate_v09.c naturally emits
# every target instruction; retail reserves a2 for the later flags argument,
# rotating that load before the current/parent classification chain.
reorder:0x38=0x94,0x3c=0x38,0x40=0x3c,0x44=0x40,0x48=0x44,0x4c=0x48,0x50=0x4c,0x54=0x50,0x58=0x54,0x5c=0x58,0x60=0x5c,0x64=0x60,0x68=0x64,0x6c=0x68,0x70=0x6c,0x74=0x70,0x78=0x74,0x7c=0x78,0x80=0x7c,0x84=0x80,0x88=0x84,0x8c=0x88,0x90=0x8c,0x94=0x90
# Once a2 is reserved, the same natural representation graph uses the retail
# v1/t1..t6 carrier allocation through the bounded classification web.
fields:0x54:rt=v1@t1
fields:0x5c:rt=v1@t1
fields:0x60:rt=t1@t2
fields:0x64:rs=t1@t2,rt=a2@v1
fields:0x68:rs=a2@v1
fields:0x70:rt=t2@t3
fields:0x74:rt=a2@v1,rd=t3@t4
fields:0x78:rs=v1@t1
fields:0x7c:rs=t2@t3,rt=t3@t4,rd=t4@t5
fields:0x80:rs=t4@t5,rt=t5@t6
fields:0x88:rt=t5@t6
fields:0x94:rt=t6@v1
fields:0x98:rs=t6@v1
# The byte12 temporary is the final consumer of the now-reserved a2 carrier.
fields:0x170:rt=a2@t2
fields:0x180:rt=a2@t2
