# True permutation of the independent pre-call instruction schedule.
reorder:0x4=0xc,0x8=0x10,0xc=0x4,0x10=0x14,0x14=0x18,0x18=0x1c,0x1c=0x20,0x20=0x8,0x24=0x30,0x2c=0x24,0x30=0x34,0x34=0x2c
fields:0x10:rs=a1@a0

# Complete private representation swap: other a0->v1; otherState v1->a0.
fields:0x70:rt=a0@v1
fields:0x74:rs=a0@v1,rt=v1@a0
fields:0x78:rs=v1@a0
fields:0x84:rs=a0@v1
fields:0x8c:rs=a0@v1
fields:0x98:rs=a0@v1
fields:0xd8:rs=v1@a0,rt=a0@v1
fields:0xdc:rs=a0@v1
fields:0xe4:rs=v1@a0
fields:0xe8:rs=v1@a0
fields:0xec:rt=a0@v1
fields:0xf0:rs=v1@a0

# Independent dx^2+dy^2 accumulation and dz^2 producer schedule.
reorder:0xb0=0xb4,0xb4=0xb0
