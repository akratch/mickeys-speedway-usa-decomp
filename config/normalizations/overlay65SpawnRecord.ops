# Four independent post-call address/outer-counter initializers.
reorder:0x68=0x6c,0x6c=0x70,0x70=0x74,0x74=0x68

# Complete inner-loop continuation carrier.
fields:0xa0:rt=t7@at
fields:0xc0:rs=t7@at

# Complete three-byte palette lookup private carrier web.
fields:0x12c:rd=t8@t7
fields:0x130:rt=t8@t7
fields:0x134:rt=t9@t8
fields:0x138:rt=t9@t8
fields:0x13c:rt=t0@t9
fields:0x140:rt=t0@t9
fields:0x144:rt=t1@t0
fields:0x148:rt=t1@t0
