fields:0x5c:rs=a0@v0
fields:0x68:rs=zero@v0,rd=zero@a0,fn=0x0@0x25
fields:0x88:rt=a0@v0
fields:0x8c:rs=a0@v0
fields:0x90:rt=a0@v0
fields:0x98:rs=zero@v0,rd=zero@a0,fn=0x0@0x25
fields:0xb8:rt=a0@v0
