# One addressed setup result occupies the preceding local word in retail.
fields:0x7c:imm=160@152
fields:0xd4:imm=160@152

# Complete four-use display-list command-pointer web.
fields:0xa4:rt=v0@v1
fields:0xb0:rs=v0@v1
fields:0xbc:rs=v0@v1
fields:0xd0:rs=v0@v1

# The shipped private overlay table stores the count addend in-place.
fields:0x08:imm=0@144
fields:0x1e0:imm=0@144
