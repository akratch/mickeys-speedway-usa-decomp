# Recover the returned-list carrier by moving the allocator copy into its
# target position, shifting only the contiguous pre-loop setup instructions.
reorder:0x48=0x90,0x4c=0x48,0x50=0x4c,0x54=0x50,0x58=0x54,0x5c=0x58,0x60=0x5c,0x64=0x60,0x68=0x64,0x6c=0x68,0x70=0x6c,0x74=0x70,0x78=0x74,0x7c=0x78,0x80=0x7c,0x84=0x80,0x88=0x84,0x8c=0x8c,0x90=0x88
fields:0x40:imm=0x78@0x70
fields:0x44:rt=a0@v1
fields:0x48:rs=v1@v0,rd=s3@a1
fields:0x4c:rt=a0@v1
fields:0x54:rt=a0@v0
fields:0x58:rt=v1@a0
fields:0x60:rs=a0@v1
fields:0x64:rs=v1@a0
fields:0x68:rt=v1@a0
fields:0x78:imm=0x4b@0x4a
fields:0x7c:imm=0x78@0x70
fields:0x80:rt=a0@v0
fields:0x8c:rs=a0@v0
fields:0x90:rs=a0@v0,rt=v1@s3
fields:0x94:rt=v1@s3
fields:0x98:rs=t0@a1,rt=v0@t0
fields:0x160:imm=0x74@0x5c
fields:0x164:imm=0x78@0x70
fields:0x178:imm=0x78@0x70
fields:0x17c:imm=0x74@0x5c
fields:0x1a8:imm=0x78@0x70
