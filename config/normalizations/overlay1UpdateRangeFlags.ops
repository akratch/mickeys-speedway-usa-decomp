# Complete frame-size/home representation: the natural compiler basin uses
# 0x78 bytes while retail owns 0x70; the only argument home follows the frame.
fields:0x0:imm=0xff88@0xff90
fields:0x28:imm=0x7c@0x74
fields:0x1dc:imm=0x78@0x70

# Complete horizontal-distance floating-point allocator web.  Numeric rd/sa
# values are COP1 fs/fd fields; all producers and consumers are asserted.
fields:0xa0:sa=16@18
fields:0xa8:sa=18@4
fields:0xb0:rd=6@16
fields:0xb4:rt=18@4,rd=16@18,sa=4@6
fields:0xb8:rd=6@16,sa=8@0
fields:0xbc:rt=8@0,rd=4@6

# Complete post-angle private integer allocator web.
fields:0xd4:rt=t1@v1
fields:0xd8:rt=t1@v1,rd=t2@t3
fields:0xdc:rs=v0@t3,rt=t2@v0,rd=v1@a0
fields:0xe0:rt=v1@a0,rd=t3@t6
fields:0xe4:rt=t3@t6,rd=t4@t7
fields:0xe8:rs=t4@t7
fields:0xf0:rs=t4@t7

# Complete vertical-range load, conversion, and arithmetic allocator webs.
fields:0xfc:rt=t5@t8
fields:0x108:rs=t5@t8,rt=10@8
fields:0x10c:rt=0@8,rd=10@0,sa=16@10
fields:0x110:rt=16@10
fields:0x120:rt=t6@t9
fields:0x124:rs=t6@t9
fields:0x128:rd=t7@t0
fields:0x12c:rt=t7@t0,rd=18@16
fields:0x134:rd=18@16,sa=6@18
fields:0x138:rt=2@18,rd=6@2

# Complete status-bit temporary webs for the two switch arms.
fields:0x16c:rt=t8@t1
fields:0x170:rs=t8@t1
fields:0x174:rt=t9@t2
fields:0x17c:rt=t9@t2
fields:0x188:rt=t0@t3
fields:0x18c:rs=t0@t3
fields:0x190:rd=t1@t4
fields:0x198:rt=t1@t4
