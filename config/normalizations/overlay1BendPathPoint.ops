# Retail prologue schedule: argument homes, call argument, and byte home.
reorder:0xc=0x10,0x10=0x20,0x14=0xc,0x18=0x14,0x20=0x18
fields:0x20:imm=0x19@0x3b
fields:0x24:imm=0x19@0x3b

# First branch's three allocator webs.  At +0x50, a2 is proven zero by the
# dominating beqz edge, so zero and a2 are identical on that predecessor.
fields:0x3c:rd=a0@v1
fields:0x40:rt=a2@a0
fields:0x50:rs=zero@a2,rd=a0@v1
fields:0x54:rt=a2@a0
fields:0x58:rt=a2@a0
fields:0x5c:rs=a0@v1
fields:0x64:rd=v1@a2
commute:0x64
fields:0x6c:rd=v0@a0
fields:0x70:rs=a0@v1,rt=v0@a0
fields:0x78:rs=v1@a2
fields:0x80:rs=v1@a2

# Next-point/result allocator web and exact stack homes.
fields:0x84:rt=t2@t3
fields:0x98:rt=v0@a0,rd=t3@t2
fields:0x9c:rd=a0@v1
fields:0xa0:rt=a0@v1,imm=0x2c@0x20
fields:0xa4:imm=0x24@0x28
fields:0xbc:rt=a0@v1,imm=0x2c@0x20
fields:0xc0:imm=0x24@0x28
fields:0xc4:imm=0x1a@0x1e
fields:0xc8:rs=a0@v1
fields:0xcc:rs=a0@v1
fields:0x108:imm=0x1a@0x1e
fields:0x10c:imm=0x1a@0x1e
fields:0x120:imm=0x1e@0x1a
fields:0x164:imm=0x1e@0x1a
