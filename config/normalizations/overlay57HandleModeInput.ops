# IDO schedules three independent loop initializers one slot later than retail.
# The other edits select an equivalent caller-register web and local-array slot.
reorder:0xe0=0xe4,0xe4=0xe8,0xe8=0xe0
fields:0x78:rt=a2@a3
fields:0x80:rs=a2@a3,rt=a2@a3
fields:0x8c:rs=a2@a3
fields:0x9c:rs=a2@a3
fields:0xe8:rd=a0@a1
fields:0xec:rt=a1@a2,imm=84@72
fields:0xf0:rt=a3@a0
fields:0xfc:rs=a1@a2
fields:0x100:rs=a0@a1,rt=a3@a0
fields:0x108:rs=a2@a3
fields:0x10c:rs=a0@a1,rt=a0@a1
commute:0x12c
fields:0x130:rs=a1@a2,rt=a1@a2
fields:0x138:imm=84@72
