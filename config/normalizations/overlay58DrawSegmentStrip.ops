# Three independent semantics-preserving scheduling permutations.
reorder:0x184=0x188,0x188=0x184
reorder:0x198=0x1a4,0x19c=0x1a8,0x1a0=0x198,0x1a4=0x19c,0x1a8=0x1a0
reorder:0x1dc=0x1e0,0x1e0=0x1dc

# Two names for one stack scalar and one dead pointer value.
fields:0xa4:imm=0x74@0x78
fields:0xd0:imm=0x74@0x78
fields:0x154:imm=0x0@0x1e

# Complete global-address/color register interchange.
fields:0xf0:rt=v1@a0
fields:0xf8:rs=v1@a0,rt=v1@a0
