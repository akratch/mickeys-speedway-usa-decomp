# Complete private coefficient-1 schedule.  The natural source emits the same
# four products and three additions, but schedules each next constant before
# closing the current sum.  This is a one-to-one permutation of the reviewed
# arithmetic/constant-load DAG and carries attached HILO relocations with it.
reorder:0x49c=0x4a0,0x4a0=0x4a4,0x4a4=0x4a8,0x4a8=0x49c,0x4ac=0x4b0,0x4b0=0x4b4,0x4b4=0x4b8,0x4b8=0x4ac,0x4e4=0x4e8,0x4e8=0x4e4

# Complete private floating-point temporary webs for coefficient1,
# coefficient2, and the final derivative's commutative 3*a product.  Integer
# registers, FP pool registers, CFG, frame, stack homes, constants, and every
# instruction through +0x498 are already naturally exact.
fields:0x49c:rt=0xa@0x6
fields:0x4a4:rd=0xa@0x6,sa=0x8@0x6
fields:0x4a8:rt=0x8@0x6,rd=0xa@0x8,sa=0x6@0x8
fields:0x4b4:rt=0x6@0xc,rd=0xc@0x6,sa=0x8@0x6
fields:0x4b8:rt=0x8@0x6,rd=0x6@0x8,sa=0xa@0x8
fields:0x4c4:rt=0xa@0x8,rd=0x8@0xa
fields:0x4c8:sa=0x8@0xa
fields:0x4cc:rt=0x4@0x8
fields:0x4d4:rd=0x4@0x8,sa=0x6@0x4
fields:0x4d8:rt=0x4@0x8
fields:0x4e0:rt=0x0@0x4,rd=0x8@0x0,sa=0xa@0x6
fields:0x4e4:rt=0x4@0xc,rd=0xc@0x8,sa=0xa@0x4
fields:0x4e8:rt=0x6@0x4,rd=0xa@0x6
fields:0x52c:rt=0x12@0x6,rd=0x6@0x12
