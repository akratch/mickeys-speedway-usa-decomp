# The compiler emitted the same fourteen natural setup instructions. Retail
# schedules the independent descriptor initialization around the RA save and
# float-constant setup; no relocation occurs in this window.
reorder:0x0=0x0,0x4=0x8,0x8=0x14,0xc=0x4,0x10=0x18,0x14=0x20,0x18=0xc,0x1c=0x10,0x20=0x2c,0x24=0x30,0x28=0x1c,0x2c=0x24,0x30=0x34,0x34=0x28
# A bounded rotation of the three integer temporaries induced by that schedule.
fields:0x8:rt=t7@t6
fields:0xc:rt=t6@t8
fields:0x14:rs=t7@t6,rt=t8@t7
fields:0x18:rt=t6@t8
fields:0x20:rt=t8@t7
