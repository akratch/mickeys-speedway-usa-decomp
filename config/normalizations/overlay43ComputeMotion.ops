# Straight-line post-call schedule permutation. Every instruction is generated
# by candidate_v13.c; this is a bijection over the complete tail schedule web.
reorder:0x8c=0x90,0x90=0x94,0x94=0x8c,0x98=0x9c,0x9c=0x98,0xa0=0xa0,0xa4=0xa8,0xa8=0xa4,0xac=0xb0,0xb0=0xb4,0xb4=0xb8,0xb8=0xbc,0xbc=0xac
# The same web's FP carrier permutation: divisor f2->f0, D_24 f0->f2,
# zero f10->f4, and the first quotient chain f16/f18/f4->f10/f16/f18.
fields:0x74:rt=2@0
fields:0x88:rt=2@0
fields:0x90:rt=0@2
fields:0x98:rt=2@0
fields:0x9c:rd=10@4
fields:0xa0:rt=0@2
fields:0xa4:rt=16@10
fields:0xa8:rt=10@4
fields:0xac:rt=2@0,rd=16@10,sa=18@16
fields:0xb0:rd=18@16,sa=4@18
fields:0xb4:rt=4@18
fields:0xbc:rt=0@2
fields:0xc0:rt=2@0
