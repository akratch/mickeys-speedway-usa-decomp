# Complete private-frame, pre-call owner, and null-exit CFG ledger.
# The primary pointer is precolored in a0 through its null gate and call spill,
# then naturally reloads into a3. The branch-likely delay owns the path-local
# ra reload. The secondary spill moves with the complete private frame web.
set:0x8:imm:0xffe0:0xffd0
fields:0x14:rt=a3@a0
fields:0x18:rs=a3@a0,rt=a3@a0
fields:0x1c:op=0x4@0x14,rs=a3@a0,imm=0x41@0x42
fields:0x20:op=0x0@0x23,rs=a3@sp,rt=zero@ra,imm=0x2025@0x14
set:0x24:imm:0x18:0x20
fields:0x2c:rt=a3@a0
set:0x3c:imm:0x18:0x20
set:0x50:imm:0x18:0x20
set:0x5c:imm:0x18:0x20
set:0x128:imm:0x20:0x30
