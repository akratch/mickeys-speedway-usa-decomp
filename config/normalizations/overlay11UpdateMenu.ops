# Complete stack-frame representation. The natural candidate and retail have
# identical 301-instruction CFG/register/schedule topology; only the frame
# extent and the four compiler spill homes differ. Every producer/consumer is
# asserted here, and the normalizer's final prefix digest fails loudly.
fields:0x0:imm=0xffd0@0xffb8
fields:0xc:imm=0x30@0x48
fields:0x1c:imm=0x28@0x30
# The loop's two private spill stores are semantically independent around the
# call and retail schedules them in the opposite order.
reorder:0x138=0x140,0x140=0x138
fields:0x138:imm=0x2c@0x44
fields:0x140:imm=0x20@0x24
fields:0x144:imm=0x2c@0x44
fields:0x148:imm=0x20@0x24
fields:0x198:imm=0x24@0x2c
fields:0x1b4:imm=0x24@0x2c
fields:0x214:imm=0x24@0x2c
fields:0x22c:imm=0x24@0x2c
fields:0x264:imm=0x28@0x30
fields:0x27c:imm=0x28@0x30
fields:0x28c:imm=0x28@0x30
fields:0x29c:imm=0x28@0x30
fields:0x2b4:imm=0x24@0x2c
fields:0x2bc:imm=0x28@0x30
fields:0x340:imm=0x28@0x30
fields:0x3a4:imm=0x24@0x2c
fields:0x3bc:imm=0x24@0x2c
fields:0x3f0:imm=0x24@0x2c
fields:0x3f4:imm=0x24@0x2c
fields:0x4a8:imm=0x30@0x48
