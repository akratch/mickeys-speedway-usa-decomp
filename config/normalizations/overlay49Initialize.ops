# Exact-size mode-table tail schedule. The natural branch-delay nop is first
# asserted as the equivalent `or zero,zero,zero`, then removed. The address
# materialization moves into the vacated delay slot, the conditional increment
# follows it, and the branch retargets the unchanged indexed load path.
fields:0x144:fn=0x0@0x25
drop-copy:0x144:zero:zero:overlay49Initialize
reorder:0x144=0x148,0x148=0x144
fields:0x140:imm=0x1@0x2
# Exact early address/store schedule. This is one permutation of the status
# reload, selector/table pairs, packed-data pair, and null result publication;
# no memory effect crosses another memory effect with which it can alias.
reorder:0x20=0x24,0x24=0x3c,0x28=0x28,0x2c=0x20,0x30=0x30,0x34=0x34,0x38=0x38,0x3c=0x40,0x40=0x44,0x44=0x48,0x48=0x4c,0x4c=0x50,0x50=0x54,0x54=0x58,0x58=0x5c,0x5c=0x60,0x60=0x2c,0x64=0x64,0x68=0x6c,0x6c=0x70,0x70=0x74,0x74=0x68
fields:0x34:imm=0xa@0x9
# Complete private allocator web and exact local addends after the two schedule
# normalizations above. Every field is old@new and therefore fails loudly.
fields:0x54:imm=0x0@0x8
fields:0x58:imm=0x0@0x18
fields:0x6c:rd=v0@t3
