# Natural IDO is exact in size, frame, opcode schedule, memory effects, and
# calls. These operations select retail's equivalent private FP temporary web.
fields:0x44:rd=16@10,rt=10@16
fields:0x70:sa=16@10
fields:0x74:rt=16@10
fields:0x7c:sa=10@16
fields:0x80:rt=10@16
fields:0xa8:sa=16@10
fields:0xac:rt=16@10
fields:0xc8:rt=10@16
fields:0xd4:rt=10@16
