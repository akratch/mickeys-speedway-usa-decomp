# Complete post-predicate temporary FIFO web. Every operation is a decoded
# register field or a true commutative-operand swap.
fields:0x6c:rt=t3@t7
fields:0x70:rt=t1@t2
fields:0x74:rs=t1@t2,rt=t2@t3
fields:0x78:rs=t2@t3
fields:0x80:rt=t3@t7
fields:0x84:rd=t5@t6
fields:0x8c:rs=t3@t7,rt=t4@t8
fields:0x90:rs=t4@t8,rt=t5@t6,rd=t6@t9
fields:0x94:rt=t6@t9
commute:0x90
