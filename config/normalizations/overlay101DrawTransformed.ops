# Two independent scheduling permutations: the initial command constants and
# the final command constants. Destination=source, all offsets function-local.
reorder:0x12c=0x130,0x130=0x134,0x134=0x138,0x138=0x13c,0x13c=0x140,0x140=0x144,0x144=0x148,0x148=0x12c,0x14c=0x150,0x150=0x154,0x154=0x158,0x158=0x15c,0x15c=0x14c,0x160=0x160
reorder:0x23c=0x254,0x254=0x23c

# Complete IDO temp-FIFO webs. No opcodes, immediates, FP registers, control
# flow, frame slots, or memory offsets are changed.
