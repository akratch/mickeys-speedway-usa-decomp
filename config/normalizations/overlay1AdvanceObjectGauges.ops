# Schedule the independent constant/address setup into the retail order.
reorder:0x44=0x64,0x48=0x44,0x4C=0x48,0x50=0x4C,0x54=0x50,0x58=0x54,0x64=0x58

# Adjust the moved zero-count branch and complete the pointer/index/result webs.
fields:0x48:imm=0x30@0x2F
fields:0x4C:rt=18@19
fields:0x50:rt=18@19
fields:0x64:rd=19@18
fields:0x70:rs=19@18
fields:0x90:rs=18@19,rd=3@2
fields:0xF0:rs=18@19,rd=3@2
fields:0xF8:rs=18@19,rd=3@2
fields:0xFC:rs=19@18,rt=19@18
fields:0x100:rs=18@19
fields:0x104:rs=18@19,rt=18@19

# Restore the canonical return-delay order after the trailing identity drop.
reorder:0x130=0x134,0x134=0x130
