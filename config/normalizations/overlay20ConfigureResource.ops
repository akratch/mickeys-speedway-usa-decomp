# Target selects f16 for the 1.0f live range.
fields:0xa0:imm=0x4000@0x8000

# These are true schedule rotations, not synthesized replacement words.
reorder:0xd4=0xd8,0xd8=0xdc,0xdc=0xd4
reorder:0xec=0xf0,0xf0=0xf4,0xf4=0xf8,0xf8=0xfc,0xfc=0x100,0x100=0x104,0x104=0xec
fields:0x104:rt=0x8@0x10

# Complete the three-register FP web after the schedule rotation.
fields:0x10c:imm=0x5000@0x4000
fields:0x114:imm=0x5420@0x42a0
fields:0x11c:rt=0x10@0xa
