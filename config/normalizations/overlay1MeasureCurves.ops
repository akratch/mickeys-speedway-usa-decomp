# Reproduce IDO's private prologue/first-two-call scheduling permutation.
reorder:0x0C=0x24,0x10=0x28,0x14=0x0C,0x18=0x10,0x1C=0x18,0x20=0x2C,0x24=0x34,0x28=0x38,0x2C=0x3C,0x30=0x40,0x34=0x44,0x38=0x48,0x3C=0x20,0x40=0x30,0x44=0x1C,0x48=0x4C,0x4C=0x14
reorder:0x58=0x64,0x5C=0x58,0x60=0x5C,0x64=0x60

# Reproduce the loop call's argument-load delay-slot schedule.
reorder:0xA8=0xB0,0xB0=0xA8

# Complete frame and incoming-argument-home shift (candidate frame 0x68 to
# retail frame 0x70; private saves/locals remain fixed).
fields:0x00:imm=0xFF98@0xFF90
fields:0x14:imm=0x68@0x70
fields:0x18:imm=0x6C@0x74
fields:0x1C:imm=0x70@0x78
fields:0x20:imm=0x74@0x7C
fields:0x38:imm=0x80@0x88
fields:0x3C:imm=0x70@0x78
fields:0x40:imm=0x78@0x80
fields:0x44:imm=0x68@0x70
fields:0x5C:imm=0x6C@0x74
fields:0x60:imm=0x74@0x7C
fields:0x64:imm=0x7C@0x84
fields:0x68:imm=0x84@0x8C
fields:0x74:imm=0x88@0x90
fields:0x9C:imm=0x68@0x70
fields:0xA0:imm=0x70@0x78
fields:0xA4:imm=0x78@0x80
fields:0xB0:imm=0x80@0x88
fields:0xB4:imm=0x6C@0x74
fields:0xB8:imm=0x74@0x7C
fields:0xBC:imm=0x7C@0x84
fields:0xC4:imm=0x84@0x8C
fields:0x138:imm=0x68@0x70

# Hoist the first curve result before loading the second curve's arguments.
reorder:0xB4=0xC0,0xB8=0xB4,0xBC=0xB8,0xC0=0xBC
