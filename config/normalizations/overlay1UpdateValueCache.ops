# IDO gives the loop counter and cached entry value the opposite two-register
# coloring. Assert the complete natural web before selecting retail's colors.
fields:0x28:rt=v0@a2
fields:0x2c:rt=a2@v0
fields:0x30:rs=a2@v0
fields:0x34:rs=v0@a2,rd=a2@v0
fields:0x40:rs=v0@a2,rd=a2@v0
fields:0x4c:rs=v0@a2,rd=a2@v0
fields:0x50:rt=a2@v0
fields:0x58:rs=a2@v0
fields:0x10c:rs=v0@a2,rd=a2@v0
fields:0x114:rs=v0@a2
fields:0x118:rs=v0@a2,rt=v0@a2
fields:0x120:rt=v0@a2
fields:0x128:rs=v0@a2,rd=a2@v0
fields:0x1cc:rs=v0@a2
fields:0x1d0:rs=v0@a2,rt=v0@a2
