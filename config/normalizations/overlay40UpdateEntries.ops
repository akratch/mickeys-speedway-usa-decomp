# Guarded complete normalization for overlay 40 text +0x0E8..+0x1A0.
# Move the redundant amount precolor into discarded alignment, place both
# address-low relocations at their runtime-ledger offsets, and close the one
# independent schedule hole.
reorder:0x8=0xc,0xc=0x14,0x10=0x10,0x14=0x18,0x18=0x1c,0x1c=0x20,0x20=0x24,0x24=0x28,0x28=0x2c,0x2c=0x30,0x30=0x34,0x34=0x38,0x38=0x3c,0x3c=0x40,0x40=0x44,0x44=0x48,0x48=0x4c,0x4c=0x50,0x50=0x54,0x54=0x58,0x58=0x5c,0x5c=0x60,0x60=0x64,0x64=0x68,0x68=0x6c,0x6c=0x70,0x70=0x74,0x74=0x78,0x78=0x7c,0x7c=0x80,0x80=0x84,0x84=0x88,0x88=0x8c,0x8c=0x90,0x90=0x94,0x94=0x98,0x98=0x9c,0x9c=0xa0,0xa0=0xa4,0xa4=0xa8,0xa8=0xac,0xac=0xb0,0xb0=0xb4,0xb4=0xb8,0xb8=0xbc,0xbc=0x8

# Complete decoded GPR-field ledger. Opcodes, immediates, displacements,
# memory widths, and relocation sites are already exact.
fields:0x34:rt=a0@t7
fields:0x38:rt=a2@a0,rd=t7@t8
fields:0x3c:rt=t7@t8
fields:0x40:rt=t8@t9
fields:0x48:rt=a0@t7
fields:0x4c:rs=t8@t9
fields:0x50:rt=t1@t2
fields:0x58:rt=t1@t2
fields:0x5c:rt=t9@t1
fields:0x60:rt=t1@t2,rd=t2@t3
fields:0x64:rs=t9@t1,rt=t2@t3,rd=t3@t4
fields:0x68:rs=t3@t4
fields:0x74:rt=a0@a2
fields:0x78:rs=a0@a2
fields:0x80:rt=t4@t5
fields:0x84:rt=t6@t7
fields:0x88:rs=t4@t5,rt=t5@t6
fields:0x8c:rs=t5@t6
fields:0x90:rs=a0@a2
fields:0x98:rs=a0@a2,rt=t6@t7
fields:0x9c:rs=a0@a2

# Decode the dead precolor outside the proved body into zero object padding;
# trim_elf_section rejects the object if any discarded byte is nonzero.
fields:0xbc:rs=a0@zero,rd=a2@zero,fn=0x25@0x0
