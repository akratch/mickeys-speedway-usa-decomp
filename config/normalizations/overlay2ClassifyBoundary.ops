# IDO emits one dead trailing section NOP after the common return.  Re-encode
# that no-op as an equivalent zero-register OR so the guarded drop primitive
# can remove the one-word natural-size excess.
fields:0x13c:fn=0@37
drop-copy:0x13c:zero:zero:overlay2ClassifyBoundary

# Complete 79-word scheduler permutation.  This keeps every semantic load,
# store, comparison, branch, return and relocation-bearing address operation.
reorder:0x0=0x0,0x4=0x4,0x8=0x8,0xc=0xc,0x10=0x10,0x14=0x14,0x18=0x18,0x1c=0x1c,0x20=0x20,0x24=0x28,0x28=0x50,0x2c=0x2c,0x30=0x24,0x34=0x34,0x38=0x38,0x3c=0x3c,0x40=0x40,0x44=0x44,0x48=0x48,0x4c=0x4c,0x50=0x54,0x54=0x30,0x58=0x5c,0x5c=0x60,0x60=0x64,0x64=0x68,0x68=0x6c,0x6c=0x70,0x70=0x74,0x74=0x78,0x78=0x7c,0x7c=0x80,0x80=0x88,0x84=0x84,0x88=0x58,0x8c=0x8c,0x90=0x90,0x94=0x94,0x98=0x98,0x9c=0x9c,0xa0=0xa0,0xa4=0xa4,0xa8=0xa8,0xac=0xac,0xb0=0xb0,0xb4=0xb8,0xb8=0xe0,0xbc=0xbc,0xc0=0xb4,0xc4=0xc4,0xc8=0xc8,0xcc=0xcc,0xd0=0xd0,0xd4=0xd4,0xd8=0xd8,0xdc=0xdc,0xe0=0xe4,0xe4=0xc0,0xe8=0xec,0xec=0xf0,0xf0=0xf4,0xf4=0xf8,0xf8=0xfc,0xfc=0x100,0x100=0x104,0x104=0x108,0x108=0x10c,0x10c=0x110,0x110=0x118,0x114=0x114,0x118=0xe8,0x11c=0x11c,0x120=0x120,0x124=0x124,0x128=0x128,0x12c=0x12c,0x130=0x130,0x134=0x138,0x138=0x134

