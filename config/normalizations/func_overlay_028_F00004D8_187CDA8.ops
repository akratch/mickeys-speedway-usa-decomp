# One complete two-instruction scheduler permutation in the independent
# distance-squared expression.
reorder:0xa4=0xa8,0xa8=0xa4
# Complete private f8/f10 temporary web. All 14 decoded operand fields are
# included; arithmetic operations, values, uses and memory effects are fixed.
fields:0xb0:rt=0xa@0x8,rd=0x8@0xa
fields:0x12c:rd=0x8@0xa
fields:0x138:rt=0x8@0xa,sa=0xa@0x8
fields:0x154:rt=0xa@0x8
fields:0x158:rt=0xa@0x8
fields:0x160:sa=0x8@0xa
fields:0x170:rt=0x8@0xa
fields:0x174:rt=0x8@0xa
fields:0x178:rd=0xa@0x8
fields:0x17c:sa=0xa@0x8
fields:0x188:rt=0xa@0x8,rd=0x8@0xa
