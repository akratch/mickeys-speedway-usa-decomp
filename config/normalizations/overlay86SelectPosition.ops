# Complete private stack-home mapping. All producers and consumers of the
# five call-surviving homes are asserted; frame size and save slots are exact.
fields:0x14:imm=0x1c@0x2c
fields:0x24:imm=0x34@0x20
fields:0x28:imm=0x1c@0x2c
fields:0x30:imm=0x30@0x1c
fields:0x34:imm=0x34@0x20
fields:0x3c:imm=0x30@0x1c
fields:0x48:imm=0x24@0x34
fields:0xa4:imm=0x20@0x30
fields:0xa8:imm=0x34@0x20
fields:0xb4:imm=0x24@0x34
fields:0xb8:imm=0x20@0x30
fields:0xbc:imm=0x34@0x20
fields:0xd8:imm=0x24@0x34
fields:0xe8:imm=0x24@0x34
fields:0xf0:imm=0x20@0x30
fields:0xf8:imm=0x24@0x34
fields:0x108:imm=0x24@0x34
fields:0x13c:imm=0x24@0x34
fields:0x148:imm=0x24@0x34

# Retail evaluates the two independent equality operands in the opposite
# order. Preserve both loads as a true permutation and rename their complete
# private t6/t7 definitions; the shared bnel remains unchanged.
reorder:0xfc=0x100,0x100=0xfc
fields:0xfc:rt=t7@t6
fields:0x100:rt=t6@t7
