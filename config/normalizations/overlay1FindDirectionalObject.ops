# One coherent address-taken count home: the natural A8-frame result uses
# sp+0x94; retail uses the otherwise identical sp+0xA4 home at every site.
fields:0x54:imm=0x94@0xA4
fields:0x74:imm=0x94@0xA4
fields:0xA0:imm=0x94@0xA4
fields:0xAC:imm=0x94@0xA4
fields:0xC8:imm=0x94@0xA4
fields:0x148:imm=0x94@0xA4
fields:0x184:imm=0x94@0xA4
fields:0x194:imm=0x94@0xA4
fields:0x1A0:imm=0x94@0xA4
fields:0x1AC:imm=0x94@0xA4

# One private two-instruction address temporary allocator color.
fields:0x170:rd=t5@v0
fields:0x174:rs=t5@v0
