# Complete five-entry queue cursor/schedule web. The relocation-carrying first
# entry stays pinned; the dynamic path replaces IDO's precomputed next pointer
# with retail's single self-updated cursor and equivalent +0x17 lookaheads.
reorder:0x0=0x0,0x4=0x4,0x8=0x8,0xc=0xc,0x10=0x10,0x14=0x14,0x18=0x18,0x1c=0x1c,0x20=0x20,0x24=0x24,0x28=0x28,0x2c=0x2c,0x30=0x30,0x34=0x34,0x38=0x38,0x3c=0x3c,0x40=0x40,0x44=0x44,0x48=0x48,0x4c=0x4c,0x50=0x50,0x54=0x54,0x58=0x58,0x5c=0x5c,0x60=0x60,0x64=0x64,0x68=0x68,0x6c=0x6c,0x70=0x70,0x74=0x74,0x78=0x7c,0x7c=0x80,0x80=0x84,0x84=0x88,0x88=0x8c,0x8c=0x90,0x90=0x94,0x94=0x98,0x98=0x9c,0x9c=0xa0,0xa0=0xa4,0xa4=0xa8,0xa8=0xac,0xac=0xb4,0xb0=0xb0,0xb4=0xb8,0xb8=0xbc,0xbc=0xc0,0xc0=0x78,0xc4=0xc4,0xc8=0xc8,0xcc=0xcc,0xd0=0xd0,0xd4=0xd4,0xd8=0xd8,0xdc=0xdc,0xe0=0xe0,0xe4=0xe4,0xe8=0xe8,0xec=0xec,0xf0=0xf0,0xf4=0xf4,0xf8=0xfc,0xfc=0xf8,0x100=0x100,0x104=0x104,0x108=0x108,0x10c=0x10c,0x110=0x110,0x114=0x114,0x118=0x118,0x11c=0x11c,0x120=0x120,0x124=0x124,0x128=0x128,0x12c=0x12c,0x130=0x130,0x134=0x134,0x138=0x138,0x13c=0x13c,0x140=0x140,0x144=0x148,0x148=0x144,0x14c=0x14c,0x150=0x150,0x154=0x154,0x158=0x158,0x15c=0x15c,0x160=0x160,0x164=0x164,0x168=0x168,0x16c=0x16c,0x170=0x170,0x174=0x174,0x178=0x178,0x17c=0x17c,0x180=0x180,0x184=0x184,0x188=0x188,0x18c=0x18c,0x190=0x194,0x194=0x190,0x198=0x198,0x19c=0x19c,0x1a0=0x1a0

# Collapse the equivalent v1/current plus v0/next pair to retail's v0 cursor.
fields:0x8:rt=v1@v0
fields:0xc:rs=v1@v0,rt=v1@v0
fields:0x24:rs=v1@v0
fields:0x74:rs=v1@v0
fields:0x7c:imm=0xb@0x17
fields:0x80:rs=v1@v0
fields:0x88:imm=0xb@0x17
fields:0x8c:rs=v1@v0
fields:0x90:rs=v1@v0
fields:0x94:rs=v1@v0
fields:0x98:rs=v1@v0
fields:0xa0:rs=v1@v0
fields:0xa8:rs=v1@v0
