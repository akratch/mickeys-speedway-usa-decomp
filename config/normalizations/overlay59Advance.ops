# First place the compiler's identical prologue instruction set into the
# shipped schedule. Attached relocations move with their instructions.
reorder:0x0=0x0,0x4=0x14,0x8=0x1c,0xc=0x10,0x10=0x18,0x14=0x38,0x18=0x20,0x1c=0x24,0x20=0x28,0x24=0x2c,0x28=0x30,0x2c=0x4,0x30=0x8,0x34=0x34,0x38=0x3c,0x3c=0x40,0x40=0x44,0x44=0x48,0x48=0x4c,0x4c=0x50,0x50=0x54,0x54=0xc

# Resolve the existing runtime-relocated local addends and calls before the
# duplicate private switch table and compiler relocation entries are removed.
fields:0x54:imm=0x0@0x18
fields:0x8c:imm=0x0@0x1c
fields:0xac:target=0x0@0x1c
fields:0x1a8:imm=0x0@0x5a0
fields:0x224:target=0x0@0x1c
fields:0x2a8:target=0x0@0x1c
fields:0x300:target=0x0@0x1c
fields:0x3cc:imm=0x0@0x44
