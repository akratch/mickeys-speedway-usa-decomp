# Remove IDO's private overlap-array base spill/reload representation.
fields:0x84:op=0x2b@0x0,rs=0x1d@0x8,rt=0x8@0x0,imm=0xbc@0x4025
drop-copy:0x84:t0:t0:overlay20UpdateGrid

# Recover retail's frame, overlap-array base, and local rematerialization.
fields:0x0:imm=0xfe78@0xfec0
reorder:0x78=0x7c,0x7c=0x80,0x80=0x78
fields:0x80:imm=0xc0@0x6c
fields:0x18c:op=0x23@0x9,imm=0xbc@0x6c
fields:0x358:imm=0x188@0x140

# Move each post-test decrement into retail's branch delay slot.
reorder:0x144=0x148,0x148=0x14c,0x14c=0x150,0x150=0x154,0x154=0x15c,0x158=0x158,0x15c=0x144

# Retail schedules the vertex advance after FP clamping and the countdown in
# the loop backedge delay slot.
